{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/demo", "destination": "/app" },
    { "source": "/demo/:path*", "destination": "/app" },
    { "source": "/libraries", "destination": "/app" },
    { "source": "/libraries/:path*", "destination": "/app" },
    { "source": "/practice/:path*", "destination": "/app" },
    { "source": "/billing/:path*", "destination": "/app" },
    { "source": "/featured", "destination": "/app" },
    { "source": "/stats", "destination": "/app" },
    { "source": "/account", "destination": "/app" }
  ]
}
