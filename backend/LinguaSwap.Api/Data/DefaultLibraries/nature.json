    { "translations": { "en": "slope", "es": "pendiente", "fr": "pente", "de": "Hang", "it": "pendio", "pt": "encosta" } },
    { "translations": { "en": "gravel", "es": "grava", "fr": "gravier", "de": "Kies", "it": "ghiaia", "pt": "cascalho" } },
    { "translations": { "en": "clay", "es": "arcilla", "fr": "argile", "de": "Ton", "it": "argilla", "pt": "argila" } },
    { "translations": { "en": "mud", "es": "barro", "fr": "boue", "de": "Schlamm", "it": "fango", "pt": "lama" } },
    { "translations": { "en": "pebble", "es": "guijarro", "fr": "caillou", "de": "Kiesel", "it": "ciottolo", "pt": "seixo" } },
    { "translations": { "en": "boulder", "es": "roca", "fr": "rocher", "de": "Felsblock", "it": "masso", "pt": "rochedo" }, "notes": "A very large rock, typically rounded, not any large stone." },
    { "translations": { "en": "crater", "es": "cráter", "fr": "cratère", "de": "Krater", "it": "cratere", "pt": "cratera" } },
    { "translations": { "en": "cape", "es": "cabo", "fr": "cap", "de": "Kap", "it": "capo", "pt": "cabo" } },
    { "translations": { "en": "delta", "es": "delta", "fr": "delta", "de": "Delta", "it": "delta", "pt": "delta" } },
    { "translations": { "en": "estuary", "es": "estuario", "fr": "estuaire", "de": "Flussmündung", "it": "estuario", "pt": "estuário" } },
    { "translations": { "en": "lagoon", "es": "laguna", "fr": "lagune", "de": "Lagune", "it": "laguna", "pt": "lagoa" } },
    { "translations": { "en": "reef", "es": "arrecife", "fr": "récif", "de": "Riff", "it": "scogliera", "pt": "recife" } },
    { "translations": { "en": "seaweed", "es": "alga", "fr": "algue", "de": "Alge", "it": "alga", "pt": "alga" }, "notes": "Macro algae visible to the eye, typically in the sea." },
    { "translations": { "en": "shell", "es": "concha", "fr": "coquillage", "de": "Muschel", "it": "conchiglia", "pt": "concha" }, "notes": "A hard outer covering of a mollusk, not a bomb or building." },
    { "translations": { "en": "crab", "es": "cangrejo", "fr": "crabe", "de": "Krabbe", "it": "granchio", "pt": "caranguejo" } },
    { "translations": { "en": "lobster", "es": "langosta", "fr": "homard", "de": "Hummer", "it": "aragosta", "pt": "lagosta" } },
    { "translations": { "en": "shrimp", "es": "gamba", "fr": "crevette", "de": "Garnele", "it": "gamberetto", "pt": "camarão" } },
    { "translations": { "en": "octopus", "es": "pulpo", "fr": "poulpe", "de": "Krake", "it": "polpo", "pt": "polvo" } },
    { "translations": { "en": "penguin", "es": "pingüino", "fr": "pingouin", "de": "Pinguin", "it": "pinguino", "pt": "pinguim" } },
    { "translations": { "en": "seagull", "es": "gaviota", "fr": "mouette", "de": "Möwe", "it": "gabbiano", "pt": "gaivota" } },
    { "translations": { "en": "heron", "es": "garza", "fr": "héron", "de": "Reiher", "it": "airone", "pt": "garça" } },
    { "translations": { "en": "stork", "es": "cigüeña", "fr": "cigogne", "de": "Storch", "it": "cicogna", "pt": "cegonha" } },
    { "translations": { "en": "falcon", "es": "halcón", "fr": "faucon", "de": "Falke", "it": "falco", "pt": "falcão" } },
    { "translations": { "en": "hawk", "es": "gavilán", "fr": "épervier", "de": "Habicht", "it": "sparviero", "pt": "gavião" }, "notes": "A medium-sized predatory bird; smaller than an eagle, larger than a falcon." },
    { "translations": { "en": "raven", "es": "cuervo", "fr": "corbeau", "de": "Rabe", "it": "corvo", "pt": "corvo" }, "notes": "A large black bird; larger and more powerful than a crow." },
    { "translations": { "en": "magpie", "es": "urraca", "fr": "pie", "de": "Elster", "it": "gazza", "pt": "pega" } },
    { "translations": { "en": "robin", "es": "petirrojo", "fr": "rouge-gorge", "de": "Rotkehlchen", "it": "pettirosso", "pt": "pisco" } },
    { "translations": { "en": "finch", "es": "pinzón", "fr": "pinson", "de": "Fink", "it": "fringuello", "pt": "tentilhão" } },
    { "translations": { "en": "woodpecker", "es": "pájaro carpintero", "fr": "pic", "de": "Specht", "it": "picchio", "pt": "pica-pau" } },
    { "translations": { "en": "pigeon", "es": "paloma", "fr": "pigeon", "de": "Taube", "it": "piccione", "pt": "pombo" } },
    { "translations": { "en": "parrot", "es": "loro", "fr": "perroquet", "de": "Papagei", "it": "pappagallo", "pt": "papagaio" } },
    { "translations": { "en": "peacock", "es": "pavo real", "fr": "paon", "de": "Pfau", "it": "pavone", "pt": "pavão" }, "notes": "The male of the species; the female is called a peahen." },
    { "translations": { "en": "chicken", "es": "pollo", "fr": "poulet", "de": "Huhn", "it": "pollo", "pt": "frango" } },
    { "translations": { "en": "turkey", "es": "pavo", "fr": "dinde", "de": "Truthahn", "it": "tacchino", "pt": "peru" } },
    { "translations": { "en": "donkey", "es": "burro", "fr": "âne", "de": "Esel", "it": "asino", "pt": "burro" } },
    { "translations": { "en": "mule", "es": "mula", "fr": "mule", "de": "Maultier", "it": "mulo", "pt": "mula" }, "notes": "Offspring of a donkey and a horse; sterile hybrid animal." },
    { "translations": { "en": "camel", "es": "camello", "fr": "chameau", "de": "Kamel", "it": "cammello", "pt": "camelo" } },
    { "translations": { "en": "llama", "es": "llama", "fr": "lama", "de": "Lama", "it": "lama", "pt": "lhama" }, "notes": "A domesticated animal from the Andes; similar to but smaller than a camel." },
    { "translations": { "en": "buffalo", "es": "búfalo", "fr": "buffle", "de": "Büffel", "it": "bufalo", "pt": "búfalo" } },
    { "translations": { "en": "antelope", "es": "antílope", "fr": "antilope", "de": "Antilope", "it": "antilope", "pt": "antílope" } },
    { "translations": { "en": "gazelle", "es": "gacela", "fr": "gazelle", "de": "Gazelle", "it": "gazzella", "pt": "gazela" }, "notes": "A small, graceful antelope; more delicate than most antelopes." },
