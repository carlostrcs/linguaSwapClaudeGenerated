    { "translations": { "en": "bud", "es": "brote", "fr": "bourgeon", "de": "Knospe", "it": "gemma", "pt": "broto" }, "notes": "The small growth on a plant before it opens into a leaf or flower." },
    { "translations": { "en": "cedar", "es": "cedro", "fr": "cèdre", "de": "Zeder", "it": "cedro", "pt": "cedro" } },
    { "translations": { "en": "conifer", "es": "conífera", "fr": "conifère", "de": "Nadelbaum", "it": "conifera", "pt": "conífera" }, "notes": "A tree that bears cones and usually has needle-like leaves." },
    { "translations": { "en": "constellation", "es": "constelación", "fr": "constellation", "de": "Sternbild", "it": "costellazione", "pt": "constelação" } },
    { "translations": { "en": "cub", "es": "cachorro", "fr": "ourson", "de": "Jungtier", "it": "cucciolo", "pt": "filhote" }, "notes": "A young wild animal, especially a bear, lion, or wolf." },
    { "translations": { "en": "drizzle", "es": "llovizna", "fr": "bruine", "de": "Nieselregen", "it": "pioggerella", "pt": "chuvisco" }, "notes": "Very light rain with tiny drops. Not heavy rain." },
    { "translations": { "en": "drought", "es": "sequía", "fr": "sécheresse", "de": "Dürre", "it": "siccità", "pt": "seca" } },
    { "translations": { "en": "dune", "es": "duna", "fr": "dune", "de": "Düne", "it": "duna", "pt": "duna" }, "notes": "A hill of sand shaped by wind, found in deserts or near coasts." },
    { "translations": { "en": "elm", "es": "olmo", "fr": "orme", "de": "Ulme", "it": "olmo", "pt": "olmo" } },
    { "translations": { "en": "fauna", "es": "fauna", "fr": "faune", "de": "Fauna", "it": "fauna", "pt": "fauna" }, "notes": "All the animals of a region or habitat. Not plants." },
    { "translations": { "en": "flock", "es": "bandada", "fr": "volée", "de": "Schwarm", "it": "stormo", "pt": "bando" }, "notes": "A group of birds flying or moving together." },
    { "translations": { "en": "flora", "es": "flora", "fr": "flore", "de": "Flora", "it": "flora", "pt": "flora" }, "notes": "All the plants of a region or habitat. Not animals." },
    { "translations": { "en": "foliage", "es": "follaje", "fr": "feuillage", "de": "Laub", "it": "fogliame", "pt": "folhagem" }, "notes": "The leaves of trees and plants collectively." },
    { "translations": { "en": "fowl", "es": "ave de corral", "fr": "volaille", "de": "Geflügel", "it": "pollame", "pt": "ave de capoeira" }, "notes": "Domesticated birds raised for food or eggs, like chickens." },
    { "translations": { "en": "gale", "es": "vendaval", "fr": "tempête", "de": "Sturm", "it": "burrasca", "pt": "vendaval" }, "notes": "A very strong wind. Stronger than a breeze, less severe than a hurricane." },
    { "translations": { "en": "glacier", "es": "glaciar", "fr": "glacier", "de": "Gletscher", "it": "ghiacciaio", "pt": "glaciar" } },
    { "translations": { "en": "gorge", "es": "garganta", "fr": "gorge", "de": "Schlucht", "it": "gola", "pt": "garganta" }, "notes": "A deep, narrow valley with steep rocky sides. Like a mini canyon." },
    { "translations": { "en": "gust", "es": "ráfaga", "fr": "rafale", "de": "Böe", "it": "raffica", "pt": "rajada" }, "notes": "A sudden, brief burst of wind. Not sustained wind." },
    { "translations": { "en": "habitat", "es": "hábitat", "fr": "habitat", "de": "Lebensraum", "it": "habitat", "pt": "habitat" } },
    { "translations": { "en": "herd", "es": "manada", "fr": "troupeau", "de": "Herde", "it": "mandria", "pt": "manada" }, "notes": "A group of large grazing animals like cattle or deer." },
    { "translations": { "en": "hibernation", "es": "hibernación", "fr": "hibernation", "de": "Winterschlaf", "it": "ibernazione", "pt": "hibernação" }, "notes": "A deep sleep state animals enter in winter to conserve energy." },
    { "translations": { "en": "horizon", "es": "horizonte", "fr": "horizon", "de": "Horizont", "it": "orizzonte", "pt": "horizonte" } },
    { "translations": { "en": "humidity", "es": "humedad", "fr": "humidité", "de": "Feuchtigkeit", "it": "umidità", "pt": "humidade" } },
    { "translations": { "en": "jungle", "es": "selva", "fr": "jungle", "de": "Dschungel", "it": "giungla", "pt": "selva" }, "notes": "Dense tropical vegetation with many plants and animals. Very humid." },
    { "translations": { "en": "lichen", "es": "liquen", "fr": "lichen", "de": "Flechte", "it": "lichene", "pt": "líquen" }, "notes": "A slow-growing organism formed from algae and fungus together." },
    { "translations": { "en": "mangrove", "es": "manglar", "fr": "palétuvier", "de": "Mangrove", "it": "mangrovia", "pt": "mangal" }, "notes": "A tropical tree with roots above ground, found in coastal swamps." },
    { "translations": { "en": "migration", "es": "migración", "fr": "migration", "de": "Wanderung", "it": "migrazione", "pt": "migração" }, "notes": "Regular seasonal movement of animals between regions." },
    { "translations": { "en": "molt", "es": "muda", "fr": "mue", "de": "Mauser", "it": "muta", "pt": "muda" }, "notes": "When birds shed feathers or animals shed skin or fur." },
    { "translations": { "en": "nesting", "es": "anidación", "fr": "nidification", "de": "Nestbau", "it": "nidificazione", "pt": "nidificação" }, "notes": "The behaviour of birds or animals building nests to lay eggs or raise young." },
    { "translations": { "en": "organism", "es": "organismo", "fr": "organisme", "de": "Organismus", "it": "organismo", "pt": "organismo" } },
    { "translations": { "en": "petal", "es": "pétalo", "fr": "pétale", "de": "Blütenblatt", "it": "petalo", "pt": "pétala" } },
    { "translations": { "en": "pine", "es": "pino", "fr": "pin", "de": "Kiefer", "it": "pino", "pt": "pinheiro" } },
    { "translations": { "en": "plateau", "es": "meseta", "fr": "plateau", "de": "Hochebene", "it": "altopiano", "pt": "planalto" }, "notes": "A large, high, flat area of land. Surrounded by steep drops." },
    { "translations": { "en": "pollen", "es": "polen", "fr": "pollen", "de": "Pollen", "it": "polline", "pt": "pólen" } },
    { "translations": { "en": "prairie", "es": "pradera", "fr": "prairie", "de": "Prärie", "it": "prateria", "pt": "pradaria" }, "notes": "Flat or rolling grassland with few trees. Found in temperate regions." },
    { "translations": { "en": "precipitation", "es": "precipitación", "fr": "précipitation", "de": "Niederschlag", "it": "precipitazione", "pt": "precipitação" }, "notes": "Water falling from sky: rain, snow, sleet, or hail." },
    { "translations": { "en": "predator", "es": "depredador", "fr": "prédateur", "de": "Raubtier", "it": "predatore", "pt": "predador" }, "notes": "An animal that hunts and eats other animals." },
    { "translations": { "en": "prey", "es": "presa", "fr": "proie", "de": "Beute", "it": "preda", "pt": "presa" }, "notes": "An animal hunted or eaten by another animal." },
    { "translations": { "en": "pupa", "es": "pupa", "fr": "chrysalide", "de": "Puppe", "it": "pupa", "pt": "pupa" }, "notes": "The stage between larva and adult in insect development." },
    { "translations": { "en": "ravine", "es": "barranco", "fr": "ravin", "de": "Schlucht", "it": "burrone", "pt": "ravina" }, "notes": "A narrow, steep-sided valley carved by water. Smaller than a canyon." },
    { "translations": { "en": "reed", "es": "caña", "fr": "roseau", "de": "Schilf", "it": "canna", "pt": "caniço" } },
    { "translations": { "en": "ridge", "es": "cresta", "fr": "arête", "de": "Grat", "it": "cresta", "pt": "crista" }, "notes": "The raised line along the top of something, not a mountain range." },
    { "translations": { "en": "rill", "es": "arroyo", "fr": "ruisseau", "de": "Bächlein", "it": "ruscello", "pt": "regato" }, "notes": "A very small stream, smaller than a creek or river." },
    { "translations": { "en": "savanna", "es": "sabana", "fr": "savane", "de": "Savanne", "it": "savana", "pt": "savana" } },
    { "translations": { "en": "ape", "es": "mono", "fr": "singe", "de": "Affe", "it": "scimmia", "pt": "macaco" }, "notes": "A large primate without a tail (like a chimpanzee), not a monkey." },
    { "translations": { "en": "bog", "es": "pantano", "fr": "marais", "de": "Sumpf", "it": "palude", "pt": "pântano" }, "notes": "Wet, spongy ground with poor drainage — wetter than a marsh." },
    { "translations": { "en": "grove", "es": "arboleda", "fr": "bosquet", "de": "Hain", "it": "boschetto", "pt": "bosque" } },
    { "translations": { "en": "acorn", "es": "bellota", "fr": "gland", "de": "Eichel", "it": "ghianda", "pt": "bolota" } },
    { "translations": { "en": "algae", "es": "alga", "fr": "algue", "de": "Alge", "it": "alga", "pt": "alga" }, "notes": "Aquatic plants, often microscopic or slimy, not seaweed specifically." },
    { "translations": { "en": "beak", "es": "pico", "fr": "bec", "de": "Schnabel", "it": "becco", "pt": "bico" } },
    { "translations": { "en": "beetle", "es": "escarabajo", "fr": "scarabée", "de": "Käfer", "it": "scarabeo", "pt": "escaravelho" } },
    { "translations": { "en": "biome", "es": "bioma", "fr": "biome", "de": "Biom", "it": "bioma", "pt": "bioma" } },
    { "translations": { "en": "bison", "es": "bisonte", "fr": "bison", "de": "Bison", "it": "bisonte", "pt": "bisonte" } },
    { "translations": { "en": "blossom", "es": "flor", "fr": "fleur", "de": "Blüte", "it": "fiore", "pt": "flor" }, "notes": "A flower or the moment it blooms, not fruit or the tree itself." },
    { "translations": { "en": "boar", "es": "jabalí", "fr": "sanglier", "de": "Wildschwein", "it": "cinghiale", "pt": "javali" }, "notes": "A wild pig, not a domesticated pig." },
    { "translations": { "en": "burrow", "es": "madriguera", "fr": "terrier", "de": "Bau", "it": "tana", "pt": "toca" }, "notes": "An animal's underground tunnel home, not a nest or den." },
    { "translations": { "en": "caterpillar", "es": "oruga", "fr": "chenille", "de": "Raupe", "it": "bruco", "pt": "lagarta" } },
    { "translations": { "en": "bramble", "es": "zarza", "fr": "ronce", "de": "Brombeere", "it": "rovo", "pt": "silva" }, "notes": "A thorny shrub or its berries, not a general hedge." },
    { "translations": { "en": "bay", "es": "bahía", "fr": "baie", "de": "Bucht", "it": "baia", "pt": "baía" } },
    { "translations": { "en": "erosion", "es": "erosión", "fr": "érosion", "de": "Erosion", "it": "erosione", "pt": "erosão" } },
    { "translations": { "en": "oak", "es": "roble", "fr": "chêne", "de": "Eiche", "it": "quercia", "pt": "carvalho" } },
    { "translations": { "en": "willow", "es": "sauce", "fr": "saule", "de": "Weide", "it": "salice", "pt": "salgueiro" } },
    { "translations": { "en": "maple", "es": "arce", "fr": "érable", "de": "Ahorn", "it": "acero", "pt": "bordo" } },
    { "translations": { "en": "chestnut", "es": "castaña", "fr": "châtaigne", "de": "Kastanie", "it": "castagna", "pt": "castanha" } },
    { "translations": { "en": "poplar", "es": "álamo", "fr": "peuplier", "de": "Pappel", "it": "pioppo", "pt": "choupo" } },
    { "translations": { "en": "ash", "es": "fresno", "fr": "frêne", "de": "Esche", "it": "frassino", "pt": "freixo" }, "notes": "A type of tree, not the powder left from fire." },
    { "translations": { "en": "cliff", "es": "acantilado", "fr": "falaise", "de": "Klippe", "it": "falesia", "pt": "falésia" } },
    { "translations": { "en": "cave", "es": "cueva", "fr": "grotte", "de": "Höhle", "it": "grotta", "pt": "gruta" } },
    { "translations": { "en": "island", "es": "isla", "fr": "île", "de": "Insel", "it": "isola", "pt": "ilha" } },
    { "translations": { "en": "peninsula", "es": "península", "fr": "péninsule", "de": "Halbinsel", "it": "penisola", "pt": "península" } },
    { "translations": { "en": "volcano", "es": "volcán", "fr": "volcan", "de": "Vulkan", "it": "vulcano", "pt": "vulcão" } },
    { "translations": { "en": "earthquake", "es": "terremoto", "fr": "tremblement de terre", "de": "Erdbeben", "it": "terremoto", "pt": "terramoto" } },
    { "translations": { "en": "avalanche", "es": "avalancha", "fr": "avalanche", "de": "Lawine", "it": "valanga", "pt": "avalanche" } },
    { "translations": { "en": "flood", "es": "inundación", "fr": "inondation", "de": "Überschwemmung", "it": "alluvione", "pt": "inundação" } },
    { "translations": { "en": "tide", "es": "marea", "fr": "marée", "de": "Gezeiten", "it": "marea", "pt": "maré" } },
    { "translations": { "en": "shore", "es": "orilla", "fr": "rivage", "de": "Ufer", "it": "riva", "pt": "margem" } },
    { "translations": { "en": "creek", "es": "arroyo", "fr": "ruisseau", "de": "Bach", "it": "ruscello", "pt": "ribeiro" }, "notes": "A small stream, larger than a rill but smaller than a river." },
    { "translations": { "en": "marsh", "es": "pantano", "fr": "marais", "de": "Sumpf", "it": "palude", "pt": "pântano" }, "notes": "Wet ground with grasses, less waterlogged than a bog." },
    { "translations": { "en": "moor", "es": "páramo", "fr": "lande", "de": "Moor", "it": "brughiera", "pt": "charneca" }, "notes": "Open hilly ground with low vegetation, not a forest." },
    { "translations": { "en": "tundra", "es": "tundra", "fr": "toundra", "de": "Tundra", "it": "tundra", "pt": "tundra" } },
    { "translations": { "en": "steppe", "es": "estepa", "fr": "steppe", "de": "Steppe", "it": "steppa", "pt": "estepe" } },
    { "translations": { "en": "peak", "es": "pico", "fr": "pic", "de": "Gipfel", "it": "picco", "pt": "pico" }, "notes": "The pointed top of a mountain, not any high point." },
