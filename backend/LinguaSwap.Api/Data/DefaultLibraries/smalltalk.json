    { "translations": { "en": "What do you think?", "es": "¿Qué opinas?", "fr": "Qu'en penses-tu ?", "de": "Was denkst du?", "it": "Cosa ne pensi?", "pt": "O que achas?" } },
    { "translations": { "en": "It depends", "es": "depende", "fr": "ça dépend", "de": "es kommt darauf an", "it": "dipende", "pt": "depende" } },
    { "translations": { "en": "I have to go", "es": "tengo que irme", "fr": "je dois y aller", "de": "ich muss gehen", "it": "devo andare", "pt": "tenho de ir" } },
    { "translations": { "en": "Talk to you soon", "es": "hablamos pronto", "fr": "à bientôt", "de": "wir sprechen uns bald", "it": "a presto", "pt": "falamos em breve" } },
    { "translations": { "en": "I'm learning...", "es": "estoy aprendiendo...", "fr": "j'apprends...", "de": "ich lerne...", "it": "sto imparando...", "pt": "estou a aprender..." } },
    { "translations": { "en": "Just a moment", "es": "un momento", "fr": "un instant", "de": "einen Moment", "it": "un momento", "pt": "um momento" } },
