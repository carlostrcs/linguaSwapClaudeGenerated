    { "translations": { "en": "How was your day?", "es": "¿Qué tal tu día?", "fr": "Comment s'est passée ta journée ?", "de": "Wie war dein Tag?", "it": "Com'è andata la giornata?", "pt": "Como foi o teu dia?" } },
