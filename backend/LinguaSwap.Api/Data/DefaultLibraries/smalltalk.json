    { "translations": { "en": "It was nice talking to you", "es": "ha sido un placer hablar contigo", "fr": "c'était sympa de discuter", "de": "schön, mit dir zu reden", "it": "è stato bello parlare con te", "pt": "foi bom falar contigo" } },
    { "translations": { "en": "What time is it?", "es": "¿Qué hora es?", "fr": "Quelle heure est-il ?", "de": "Wie spät ist es?", "it": "Che ore sono?", "pt": "Que horas são?" } },
    { "translations": { "en": "Where do you live?", "es": "¿Dónde vives?", "fr": "Où habites-tu ?", "de": "Wo wohnst du?", "it": "Dove abiti?", "pt": "Onde moras?" } },
    { "translations": { "en": "Do you have children?", "es": "¿Tienes hijos?", "fr": "As-tu des enfants ?", "de": "Hast du Kinder?", "it": "Hai figli?", "pt": "Tens filhos?" } },
    { "translations": { "en": "I like it", "es": "me gusta", "fr": "j'aime ça", "de": "es gefällt mir", "it": "mi piace", "pt": "gosto disso" } },
