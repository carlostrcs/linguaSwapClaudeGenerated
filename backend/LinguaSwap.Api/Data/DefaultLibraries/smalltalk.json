    { "translations": { "en": "Sit down, please", "es": "siéntate, por favor", "fr": "assieds-toi, s'il te plaît", "de": "setz dich, bitte", "it": "siediti, per favore", "pt": "senta-te, por favor" } },
    { "translations": { "en": "How nice!", "es": "¡Qué bien!", "fr": "Que c'est bien !", "de": "Wie schön!", "it": "Che bello!", "pt": "Que bom!" } },
    { "translations": { "en": "I'm sorry to hear that", "es": "lo siento mucho", "fr": "je suis désolé de l'apprendre", "de": "das tut mir leid", "it": "mi dispiace", "pt": "lamento saber" } },
    { "translations": { "en": "Good idea", "es": "buena idea", "fr": "bonne idée", "de": "gute Idee", "it": "buona idea", "pt": "boa ideia" } },
    { "translations": { "en": "You're right", "es": "tienes razón", "fr": "tu as raison", "de": "du hast recht", "it": "hai ragione", "pt": "tens razão" } },
    { "translations": { "en": "I'm joking", "es": "estoy bromeando", "fr": "je plaisante", "de": "ich mache Spaß", "it": "sto scherzando", "pt": "estou a brincar" } },
    { "translations": { "en": "What a surprise!", "es": "¡Qué sorpresa!", "fr": "Quelle surprise !", "de": "Was für eine Überraschung!", "it": "Che sorpresa!", "pt": "Que surpresa!" } },
