    { "translations": { "en": "How are you?", "es": "¿Cómo estás?", "fr": "Comment ça va ?", "de": "Wie geht es dir?", "it": "Come stai?", "pt": "Como estás?" } },
    { "translations": { "en": "I'm fine", "es": "estoy bien", "fr": "je vais bien", "de": "mir geht es gut", "it": "sto bene", "pt": "estou bem" } },
    { "translations": { "en": "And you?", "es": "¿Y tú?", "fr": "Et toi ?", "de": "Und dir?", "it": "E tu?", "pt": "E tu?" } },
    { "translations": { "en": "nice to meet you", "es": "encantado de conocerte", "fr": "enchanté", "de": "freut mich", "it": "piacere di conoscerti", "pt": "muito prazer" } },
    { "translations": { "en": "What's your name?", "es": "¿Cómo te llamas?", "fr": "Comment tu t'appelles ?", "de": "Wie heißt du?", "it": "Come ti chiami?", "pt": "Como te chamas?" } },
    { "translations": { "en": "My name is...", "es": "me llamo...", "fr": "je m'appelle...", "de": "ich heiße...", "it": "mi chiamo...", "pt": "chamo-me..." } },
    { "translations": { "en": "Where are you from?", "es": "¿De dónde eres?", "fr": "D'où viens-tu ?", "de": "Woher kommst du?", "it": "Di dove sei?", "pt": "De onde és?" } },
    { "translations": { "en": "I'm from...", "es": "soy de...", "fr": "je viens de...", "de": "ich komme aus...", "it": "vengo da...", "pt": "sou de..." } },
    { "translations": { "en": "How old are you?", "es": "¿Cuántos años tienes?", "fr": "Quel âge as-tu ?", "de": "Wie alt bist du?", "it": "Quanti anni hai?", "pt": "Quantos anos tens?" } },
    { "translations": { "en": "Do you speak English?", "es": "¿Hablas inglés?", "fr": "Parles-tu anglais ?", "de": "Sprichst du Englisch?", "it": "Parli inglese?", "pt": "Falas inglês?" } },
    { "translations": { "en": "I don't understand", "es": "no entiendo", "fr": "je ne comprends pas", "de": "ich verstehe nicht", "it": "non capisco", "pt": "não entendo" } },
