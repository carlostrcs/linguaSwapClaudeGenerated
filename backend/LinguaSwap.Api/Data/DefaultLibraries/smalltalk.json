    { "translations": { "en": "Speak slowly, please", "es": "habla despacio, por favor", "fr": "parle lentement, s'il te plaît", "de": "sprich bitte langsam", "it": "parla lentamente, per favore", "pt": "fala devagar, por favor" } },
