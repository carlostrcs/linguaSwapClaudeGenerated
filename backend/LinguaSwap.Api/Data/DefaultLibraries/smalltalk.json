    { "translations": { "en": "I'm not sure", "es": "no estoy seguro", "fr": "je ne suis pas sûr", "de": "ich bin mir nicht sicher", "it": "non sono sicuro", "pt": "não tenho a certeza" } },
    { "translations": { "en": "What does it mean?", "es": "¿Qué significa?", "fr": "Qu'est-ce que ça veut dire ?", "de": "Was bedeutet das?", "it": "Cosa significa?", "pt": "O que significa?" } },
    { "translations": { "en": "How do you say...?", "es": "¿Cómo se dice...?", "fr": "Comment dit-on... ?", "de": "Wie sagt man...?", "it": "Come si dice...?", "pt": "Como se diz...?" } },
